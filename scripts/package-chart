#!/bin/bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

CHART_DIR=charts/rke2-patcher
VERSION=$(yq -r '.version' "${CHART_DIR}/Chart.yaml")

if [[ -z "${VERSION}" || "${VERSION}" == null || "${VERSION}" == */* || "${VERSION}" == . || "${VERSION}" == .. ]]; then
    echo "Invalid chart version: ${VERSION}" >&2
    exit 1
fi

rm -rf -- "${CHART_DIR}/${VERSION}"
rm -f index.yaml
mkdir -p "${CHART_DIR}/${VERSION}"
tar -C "${CHART_DIR}" --exclude="./${VERSION}" -cf - . |
    tar -C "${CHART_DIR}/${VERSION}" -xf -

bin/charts-build-scripts zip --chart "rke2-patcher/${VERSION}"